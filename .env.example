# Digi Güvenlik — Ortam Değişkenleri Şablonu (.env.example)
# Bu dosyayı ".env.local" olarak kopyalayıp gerçek değerlerle doldurun.
# DİKKAT: .env.local dosyasını ASLA Git deposuna eklemeyin!

# Site & İndeksleme Kontrolü
NEXT_PUBLIC_SITE_URL=https://digiguvenlik.com
ALLOW_INDEXING=true

# Oturum İmzalama Anahtarı (En az 32 bayt rastgele hex: openssl rand -hex 32)
AUTH_SECRET=degistirin-en-az-32-karakter-guclu-rastgele-anahtar

# E-posta (SMTP) Ayarları — Boş bırakılırsa mailler data/mail-logs/ klasörüne kaydedilir
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ORDER_NOTIFICATION_EMAIL=siparis@digiguvenlik.com

# Arama Konsolları Doğrulama Kodları (Bölüm 5)
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_API_KEY=

# Analitik & Consent Mode v2 (Sadece KVKK çerez onayı sonrası yüklenir)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YANDEX_METRICA_ID=
