# Digi Güvenlik — Ortam Değişkenleri Şablonu (.env.example)
# Bu dosyayı ".env.local" olarak kopyalayıp gerçek değerlerle doldurun.
# DİKKAT: .env.local dosyasını ASLA Git deposuna eklemeyin!

# Oturum imzalama anahtarı (En az 32 bayt rastgele hex: openssl rand -hex 32)
AUTH_SECRET=degistirin-en-az-32-karakter-guclu-rastgele-anahtar

# E-posta (SMTP) Ayarları — Boş bırakılırsa e-postalar data/mail-logs/ altına kaydedilir
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ORDER_NOTIFICATION_EMAIL=siparis@digiguvenlik.com

# Opsiyonel Analitik ve Search Console (Çerez onayı sonrası etkinleştirilir)
NEXT_PUBLIC_SITE_URL=https://digiguvenlik.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
